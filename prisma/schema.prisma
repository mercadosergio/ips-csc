generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/prisma"
  engineType   = "binary"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlserver"
}

model Client {
  id       Int     @id(map: "PK__Client__3213E83F83A9D2AF") @default(autoincrement())
  document String? @db.VarChar(20)
  fullName String? @db.VarChar(200)
  Order    Order[]
}

model Order {
  id        Int       @id(map: "PK__Order__3213E83FAC0D25D8") @default(autoincrement())
  createdAt DateTime? @db.DateTime
  total     Decimal   @db.Decimal(18, 2)
  clientId  Int?
  Client    Client?   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_client_id")
}
